# --- Supabase (hosted) ---------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...      # used only to fetch demo tokens
SUPABASE_SECRET_KEY=sb_secret_...                # provisioning script ONLY. Never give this to the agent.
# SUPABASE_JWT_SECRET=                           # only for legacy HS256 projects

# Owner connection: migrations, seed, key setup, ground truth in tests. Not used by the service.
ADMIN_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The ONLY connection the service uses. Session pooler (5432): psycopg prepares repeated statements,
# which the transaction pooler (6543) does not support.
AGENT_DATABASE_URL=postgresql://sql_agent_login.<project-ref>:<agent-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# HMAC key binding identity to each DB transaction (python -c "import secrets;print(secrets.token_hex(32))")
IDENTITY_HMAC_KEY_ID=k1
IDENTITY_HMAC_KEY=

DEMO_USER_PASSWORD=

# --- Models -------------------------------------------------------------------
OPENROUTER_API_KEY=

# --- Traces -------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region of your Langfuse project: EU https://cloud.langfuse.com, US https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
